# Required - generate with: openssl rand -hex 32
JWT_SECRET_KEY=change-me-to-a-random-64-char-hex-string
API_KEY=change-me-to-a-random-api-key

# Wazuh API
WAZUH_API_URL=https://127.0.0.1:45000
WAZUH_USER=wazuh-wui
WAZUH_PASS=change-me

# Wazuh Indexer (OpenSearch)
WAZUH_INDEXER_URL=https://127.0.0.1:9200
WAZUH_INDEXER_USER=admin
WAZUH_INDEXER_PASS=change-me

# Suricata SSH
SURICATA_HOST=192.168.1.100
SURICATA_PORT=22
SURICATA_USER=suricata
SURICATA_PASS=change-me

# Wazuh Docker
WAZUH_DOCKER_CONTAINER=single-node-wazuh.manager-1

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=change-me-redis-password

# Ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b

# Admin supervision
ADMIN_API_KEY=change-me-admin-key
ADMIN_JWT_SECRET=change-me-admin-jwt-secret

# PostgreSQL (for docker-compose.prod.yml)
POSTGRES_PASSWORD=change-me-postgres-password

# Environment: development or production
ENVIRONMENT=development

# Threat Intelligence (F3)
THREAT_INTEL_ENABLED=false
THREAT_INTEL_PROVIDER=abuseipdb
THREAT_INTEL_API_KEY=
THREAT_INTEL_CACHE_TTL_SECONDS=3600
THREAT_INTEL_TIMEOUT_SECONDS=10
