@startuml
skinparam classAttributeIconSize 0
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam packageFontSize 14
skinparam backgroundColor #FFFFFF
hide empty members
skinparam ArrowThickness 2
skinparam ArrowColor #333333

package "Business\n(Services & Repositories)" #D8F0D8 {
  ' ----- Security Services -----
  interface "ISecurityService" <<interface>> {
    +get_events_since(since:DateTime):List
    +get_events_by_severity(min_sev:Integer):List
    +get_topology():Map
  }
  class "WazuhService" {
    -api_url:String
    -credentials:AuthCredentials
    #agent_cache:Map
    +get_agents():List
    +refresh_agent_cache():Void
    +sync_alerts(r:IAlertRepository):List
    +build_topology(dr:IDeviceRepository, ar:IAlertRepository):Map
    +get_active_alerts(r:IAlertRepository):List
    +get_agent_identity(id:String):Map
    +stream_agent_report(id:String, rr:IIAReportRepository):InputStream
    +stream_global_report(rr:IIAReportRepository):InputStream
  }
  class "SuricataService" {
    -config:ISettings
    +get_alerts_since(since:DateTime, r:IAlertRepository):List
    +send_command(cmd:String, r:IAlertRepository):Map
    +get_recent_threats(r:IAlertRepository):List
  }
  ' ----- Infrastructure Services -----
  class "ScannerService" {
    -interfaces:List
    +get_active_interfaces():List
    +scan_network(iface:String, dr:IDeviceRepository, lr:IConnectionLogRepository):List
    +start_continuous_scan(interval:Integer, dr:IDeviceRepository, lr:IConnectionLogRepository):Void
    +stop_continuous_scan():Void
  }
  class "AnalysisService" {
    -ollama_endpoint:String
    -model_name:String
    +analyze_threat(timeline:List, r:IAlertRepository):String
    +generate_risk_report(agent_id:String, r:IAlertRepository, rr:IIAReportRepository):String
    -call_llm(prompt:String):String
  }
  class "BroadcasterService" {
    -connections:Set
    -lock:Lock
    +register_listener(l:IEventListener):Void
    +unregister_listener(l:IEventListener):Void
    +broadcast_event(e:SecurityEvent):Void
    -notify_listeners(e:SecurityEvent):Void
  }
  interface "IEventListener" <<interface>> {
    +handle_event(e:SecurityEvent):Void
  }
  ' ----- Repository Interfaces -----
  interface "IDeviceRepository" <<interface>> {
    +find_by_ip(ip:String):Device
    +find_all():List
    +save(d:Device):Void
    +update_status(ip:String, online:Boolean):Void
  }
  interface "IAlertRepository" <<interface>> {
    +save(a:Alert):Void
    +find_by_severity(min_sev:Integer):List
    +find_since(since:DateTime):List
    +find_by_source(source:String):List
    +purge_older_than(days:Integer):Void
  }
  interface "IAssetRepository" <<interface>> {
    +find_by_ip(ip:String):Asset
    +save(a:Asset):Void
    +update_assignment(ip:String, emp:String, dept:String):Void
  }
  interface "IConnectionLogRepository" <<interface>> {
    +save(l:ConnectionLog):Void
    +find_by_device(device_id:Long):List
    +find_since(since:DateTime):List
  }
  interface "IIAReportRepository" <<interface>> {
    +save(r:IAReport):Void
    +find_by_agent(agent_id:String):List
    +find_by_type(report_type:String):List
    +find_since(since:DateTime):List
  }
}

' Notes
note top of WazuhService
  Security service for Wazuh\nmanages agents, alerts, topology
end note
note top of SuricataService
  Security service for Suricata\nreal-time IDS alerts
end note
note top of ScannerService
  Network scanner\nARP scan, machine status
end note
note top of AnalysisService
  Correlated threat analysis\nAI report generation
end note
note top of BroadcasterService
  WebSocket broadcasting\nreal-time updates
end note

@enduml