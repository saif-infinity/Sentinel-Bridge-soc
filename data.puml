@startuml
skinparam classAttributeIconSize 0
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam packageFontSize 14
skinparam backgroundColor #FFFFFF
hide empty members
skinparam ArrowThickness 2
skinparam ArrowColor #333333

package "Data\n(Entities)" #FFE0E0 {
  abstract class "BaseEntity" {
    -id:Long
    +{static}next_id():Long
    +get_id():Long
    +equals(other:Object):Boolean
    +hash_code():Integer
  }
  class "Device" {
    -id:Long
    -ip:String
    -mac:String
    -is_online:Boolean
    -is_wazuh_agent:Boolean
    +{static}next_id():Long
    +get_id():Long
    +get_ip():String
    +get_mac():String
    +is_online():Boolean
    +set_online(status:Boolean):Void
    +equals(other:Object):Boolean
    +hash_code():Integer
  }
  class "Alert" {
    -id:Long
    -description:String
    -source:String  # "WAZUH" or "SURICATA"
    -severity:Integer  # 1-5
    -timestamp:DateTime
    +{static}next_id():Long
    +get_id():Long
    +get_description():String
    +get_source():String
    +get_severity():Integer
    +get_timestamp():DateTime
    +equals(other:Object):Boolean
    +hash_code():Integer
  }
  class "Asset" {
    -id:Long
    -ip:String
    -employee_name:String
    -department:String
    +{static}next_id():Long
    +get_id():Long
    +get_ip():String
    +get_employee_name():String
    +get_department():String
    +set_assignment(emp:String, dept:String):Void
    +equals(other:Object):Boolean
    +hash_code():Integer
  }
  class "ConnectionLog" {
    -id:Long
    -device_id:Long
    -status:Boolean  # true=connected, false=disconnected
    -start_time:DateTime
    -end_time:DateTime
    +{static}next_id():Long
    +get_id():Long
    +get_device_id():Long
    +get_status():Boolean
    +get_start_time():DateTime
    +get_end_time():DateTime
    +get_duration():Duration
    +equals(other:Object):Boolean
    +hash_code():Integer
  }
  class "IAReport" {
    -id:Long
    -report_type:String  # e.g., "GLOBAL", "AGENT"
    -agent_id:String
    -content:String
    -generated_at:DateTime
    +{static}next_id():Long
    +get_id():Long
    +get_report_type():String
    +get_agent_id():String
    +get_content():String
    +get_generated_at():DateTime
    +equals(other:Object):Boolean
    +hash_code():Integer
  }
}

' Notes
note top of Device
  Network device\nip, mac, online status
end note
note top of Alert
  Security alert\nsource: Wazuh or Suricata
end note
note top of Asset
  Network asset\nmapped to employee
end note
note top of ConnectionLog
  Connection history\nfor devices
end note
note top of IAReport
  AI-generated\nsecurity reports
end note

@enduml